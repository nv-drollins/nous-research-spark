# ============================================================================
# nous-research-spark : one-shot installer configuration
# ----------------------------------------------------------------------------
# Edit these values to change what gets installed. Every value has a sane
# default for a DGX Spark (GB10) demo box. The installer sources this file.
# ============================================================================

# --- Model / vLLM -----------------------------------------------------------
# Agent-ready model recommended by NVIDIA for DGX Spark (from build.nvidia.com).
MODEL_HANDLE="nvidia/Qwen3.6-35B-A3B-NVFP4"

# vLLM OpenAI-compatible container image.
VLLM_IMAGE="vllm/vllm-openai:latest"

# Port the vLLM OpenAI API listens on (localhost only).
VLLM_PORT="8000"

# Max context length. The model natively supports 262144.
MAX_MODEL_LEN="262144"

# Fraction of (unified) GPU memory vLLM may use. 0.85 leaves headroom for
# Hermes + the OS on the 128GB unified-memory GB10.
GPU_MEMORY_UTILIZATION="0.85"

# Extra vLLM serve args (agentic: reasoning traces + OpenAI-style tool calls).
# These are appended verbatim to `vllm serve <model>`.
#
# NOTE on --tool-call-parser: this MUST match the format the *model* emits, not
# the name of the agent. Qwen3.x emits tool calls as XML
# (<tool_call><function=name><parameter=x>), so it needs `qwen3_xml`.
# Using `hermes` here (a JSON parser, named after the Hermes *model* family,
# NOT Hermes Agent) makes vLLM fail to parse every tool call: it throws
# JSONDecodeError, returns finish_reason=stop with the XML stuck in `content`,
# and the agent sees no tool_calls -> it "spins and returns to the prompt".
VLLM_EXTRA_ARGS="--reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_xml"

# Name of the docker container + systemd unit.
VLLM_CONTAINER="vllm-server"
VLLM_SERVICE="vllm-server"

# --- Hermes -----------------------------------------------------------------
# Provider type Hermes uses for a local OpenAI-compatible endpoint.
HERMES_PROVIDER="custom"
HERMES_BASE_URL="http://localhost:${VLLM_PORT}/v1"
HERMES_MODEL="${MODEL_HANDLE}"

# Comma-separated Hermes toolsets to enable out of the box for demoing.
# Canonical toolset names (see `hermes tools list`). Leave blank to keep the
# Blank Slate minimal install.
HERMES_TOOLS="web,browser,terminal,file,code_execution"

# --- Behaviour --------------------------------------------------------------
# How long (seconds) to wait for the vLLM model to finish loading before
# giving up. First run downloads ~20GB, so keep this generous.
VLLM_STARTUP_TIMEOUT="1800"
